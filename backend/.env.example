# ---------- 开发 / Persona ----------
# 设为 1 时：system_base.md 等 persona 文件每次请求都重新读盘（不缓存）。不设时按文件 mtime 失效缓存。
# DEV_RELOAD_PERSONA=1

# ---------- 部署 / CORS ----------
# 英文逗号分隔多个前端源，例如：https://yourgame.example,http://127.0.0.1:4173
# 不填则仅允许本地 Vite 默认源（127.0.0.1:3000、localhost:3000）
# CORS_ALLOW_ORIGINS=

# ---------- MiniMax（Anthropic SDK 调用，见 README）----------
# 密钥也可单独用 MINIMAX_API_KEY；与 ANTHROPIC_API_KEY 二选一即可（代码里会优先读 ANTHROPIC_API_KEY）
# 注意：只填纯 token，不要带 "Bearer " 前缀
ANTHROPIC_API_KEY=""
MINIMAX_API_KEY=""
ANTHROPIC_MODEL=MiniMax-M2.7
# 可选：显式指定兼容端点（不填时，MiniMax 模型会自动使用该地址）
MINIMAX_BASE_URL=https://api.minimax.chat/v1
