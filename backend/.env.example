# ---------- 开发 / Persona ----------
# 设为 1 时：system_base.md 等 persona 文件每次请求都重新读盘（不缓存）。不设时按文件 mtime 失效缓存。
# DEV_RELOAD_PERSONA=1

# ---------- 部署 / CORS ----------
# 英文逗号分隔多个前端源，例如：https://yourgame.example,http://127.0.0.1:4173
# 不填则仅允许本地 Vite 默认源（127.0.0.1:3000、localhost:3000）
# CORS_ALLOW_ORIGINS=

# ---------- NPC 运行模式 ----------
# scripted：完全离线固定逻辑；hybrid：关键剧情固定、普通表达可用模型；agent：模型可提出受规则约束的意图。
NPC_RUNTIME=scripted
# 可按角色逐步启用，例如：NPC_RUNTIME_ALICE=agent
# NPC_RUNTIME_ALICE=scripted
# NPC_RUNTIME_EUGEO=scripted

# ---------- MiniMax / LLM ----------
# 默认模型集中在 backend/app/llm_config.py；当前默认动作与对话模型都是 M2-H。
# 密钥也可单独用 MINIMAX_API_KEY；与 ANTHROPIC_API_KEY 二选一即可。
# 注意：只填纯 token，不要带 "Bearer " 前缀
ANTHROPIC_API_KEY=""
MINIMAX_API_KEY=""
ACTION_MODEL=M2-H
DIALOGUE_MODEL=M2-H
MINIMAX_OPENAI_BASE_URL=https://api.minimax.io/v1
# 可选：显式指定兼容端点（不填时，MiniMax 模型会自动使用该地址）
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ---------- 可插拔 AI Provider（可选） ----------
# 默认不设置，继续使用既有 MiniMax/Anthropic 兼容路径。
# 显式设置后，hybrid/agent 会通过统一适配器调用；失败自动回退 scripted。
# 支持：stepfun / sensetime / openai-compatible / minimax / anthropic
# LLM_PROVIDER=stepfun
# LLM_API_KEY=""
# LLM_BASE_URL="https://your-provider.example/v1"
# LLM_MODEL="your-model-id"
# LLM_TIMEOUT_SECONDS=45
# 阶跃星辰可使用 STEPFUN_API_KEY；商汤可使用 SENSETIME_API_KEY + SENSETIME_BASE_URL。
